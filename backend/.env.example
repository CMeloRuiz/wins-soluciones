# ===== Servidor =====
PORT=4000

# Origenes que pueden llamar a la API, separados por coma.
# En produccion pon aqui la URL del sitio publicado.
ORIGENES_PERMITIDOS=http://localhost:5173

# ===== Sesion =====
# Cadena larga y aleatoria. Generala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRETO=035865fae519466dd6e015245adffbebb961d2d120a90c9bee28d9b157c5d51777f63aff709cf003eca0aea3d6315f9c
JWT_DURACION=8h

# ===== Administrador =====
ADMIN_USUARIO=admin

# Recomendado: guarda el hash, no la clave.
#   npm run hash -- tuClaveSegura
ADMIN_CLAVE_HASH=

# Alternativa para empezar rapido: clave en texto plano.
# El servidor la hashea al arrancar, pero queda legible en este archivo.
# Usa una de las dos, no las dos.
ADMIN_CLAVE=tuClaveSeguraAqui

# ===== Subida de imagenes =====
MAX_IMAGEN_MB=4
