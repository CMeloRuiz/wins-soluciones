# ===== Servidor =====
PORT=4000

# Origenes que pueden llamar a la API, separados por coma.
# En desarrollo se listan varios puertos porque Vite salta al siguiente
# libre si el 5173 esta ocupado.
# En produccion pon aqui SOLO la URL del sitio publicado.
ORIGENES_PERMITIDOS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ===== Sesion =====
# Cadena larga y aleatoria. Generala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRETO=
JWT_DURACION=8h

# ===== Administrador =====
ADMIN_USUARIO=admin

# Recomendado: guarda el hash, no la clave.
#   npm run hash          genera uno (pide la clave por teclado)
#   npm run hash -- --probar   comprueba si una clave coincide
ADMIN_CLAVE_HASH=

# Alternativa para empezar rapido: clave en texto plano.
# El servidor la hashea al arrancar, pero queda legible en este archivo.
# Usa una de las dos, no las dos.
ADMIN_CLAVE=tuClaveSeguraAqui

# ===== Subida de imagenes =====
MAX_IMAGEN_MB=4

# Las imagenes que se suben desde el panel se guardan en Cloudinary
# (https://cloudinary.com), no en el disco del servidor: en Render ese disco
# se vacia en cada despliegue.
#
# Los tres valores salen del Dashboard de Cloudinary, en "API Keys".
# El plan gratuito no pide tarjeta.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== Base de datos =====
# Cadena de conexion de PostgreSQL en Neon (https://neon.tech).
#
# IMPORTANTE: usa la cadena "Pooled connection" del panel de Neon, no la
# directa. Se reconoce porque el host lleva "-pooler":
#
#   postgresql://USUARIO:CLAVE@ep-algo-123456-pooler.REGION.aws.neon.tech/DB?sslmode=require
#
# Sin pooling, cada reinicio del servicio deja conexiones colgando y se agota
# el limite del proyecto.
DATABASE_URL=
